---
import { getRelativeLocaleUrl } from 'astro:i18n';

const { currentLocale = 'es' } = Astro;

const languages = [
  { code: 'es', label: 'ES', flag: '🇪🇸' },
  { code: 'en', label: 'EN', flag: '🇺🇸' }
];

// Current path without the prefix if any
const currentPath = Astro.url.pathname.replace(/^\/(es|en)/, '') || '/';
---

<div class="flex items-center gap-2 rounded-full border border-gray-200 bg-white/80 p-1 backdrop-blur-sm dark:border-gray-700 dark:bg-gray-800/80 shadow-sm">
  {languages.map((lang) => (
    <a
      href={getRelativeLocaleUrl(lang.code, currentPath)}
      class={`px-3 py-1 text-xs font-bold rounded-full transition-all ${
        currentLocale === lang.code
          ? 'bg-brand text-white shadow-sm'
          : 'text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-gray-100'
      }`}
    >
      {lang.label}
    </a>
  ))}
</div>
