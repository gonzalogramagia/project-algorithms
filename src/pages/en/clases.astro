---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/Content.astro";
import SeoPage from "@/components/SeoPage.astro";
import { useTranslations } from "@/i18n/utils";

const lang = "en";
const t = useTranslations(lang);

const customLinks = [
    {
      "id": "1",
      "title": "🎥 FUNCTIONAL Programming (Franco Luque)",
      "url": "https://youtube.com/playlist?list=PLLswL1pDm9IySjKob9nqV9xzlQlfHf1T_"
    },
    {
      "id": "2",
      "title": "🎥 IMPERATIVE Programming (Franco Luque)",
      "url": "https://youtube.com/playlist?list=PLLswL1pDm9IyEJ1zCLOs8qpEJLtPE_eqE"
    },
    {
      "id": "3",
      "title": "🎥 Imperative Programming LAB (Ale Gadea)",
      "url": "https://youtube.com/playlist?list=PLLswL1pDm9Ix-uLjXPcfZN_m59luQYVhy"
    },
    {
      "id": "4",
      "title": "🎥 Imperative Programming Practice (Franco Luque)",
      "url": "https://youtube.com/playlist?list=PLLswL1pDm9Iwlb_XFikf9HUiRlLPzFjuW"
    },
    {
      "id": "back-home",
      "title": t("back"),
      "url": "/"
    }
];
---

<BaseLayout
  floatingButtonUrl="https://youtube.com/@goalritmo/playlists"
  floatingButtonIcon="lucide:play"
  floatingButtonLabel="YouTube Playlists"
>
  <SeoPage slot="head" title="Algorithms I Classes" />
  <main>
    <Content 
        title="Algorithms I Classes"
        bio="FAMAF Computing"
        links={customLinks}
    />
    <div class="py-4"></div>
  </main>
</BaseLayout>
