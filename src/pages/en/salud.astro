---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Content from "@/components/Content.astro";
import wellbeingImage from "@/assets/wellbeing.jpg";
import { useTranslations } from "@/i18n/utils";

const lang = "en";
const t = useTranslations(lang);

const saludLinks = [
    {
      "id": "1",
      "title": "⚽ Sports Grid",
      "url": "https://unc.edu.ar/vida-estudiantil/deportes-unc-2025"
    },
    {
      "id": "2",
      "title": "💪 Gym Schedules",
      "url": "https://instagram.com/p/DIe5x1qyWiG/"
    },
    {
      "id": "3",
      "title": "🍎 University Dining",
      "url": "https://unc.edu.ar/vida-estudiantil/comedor-universitario-2025"
    },
    {
      "id": "4",
      "title": "🧭 Student Paths",
      "url": "https://unc.edu.ar/vida-estudiantil/trayectorias-acad%C3%A9micas-estudiantiles"
    },
    {
      "id": "back-home",
      "title": t("back"),
      "url": "/"
    }
];
---

<BaseLayout 
  title="Student Wellbeing"
  floatingButtonUrl="https://entrenar.app/"
  floatingButtonIcon="lucide:dumbbell"
  floatingButtonLabel="Entrenar App"
  floatingButtonIconTransform="scale-x-[-1]"
>
  <main>
    <Content 
        title="Student Wellbeing"
        bio="FAMAF Computing"
        links={saludLinks}
        profileImage={wellbeingImage}
        imageScale="scale-100"
        hideCountdown={true}
    />
  </main>
</BaseLayout>
