---
import "@/styles/global.css";

import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/Footer.astro";
import ConfigModal from "@/components/ConfigModal.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "@/siteConfig";
import { Image } from "astro:assets";
import wallpaper from "@/assets/wallpaper.png";

import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n/utils";

interface Props {
  title?: string;
  floatingButtonUrl?: string;
  floatingButtonIcon?: string;
  floatingButtonLabel?: string;
  floatingButtonIconTransform?: string;
}

const lang = Astro.currentLocale as "es" | "en" || "es";
const t = useTranslations(lang);

const { 
  title = t("name"), 
  floatingButtonUrl = "https://github.com/gonzalogramagia/project-algorithms",
  floatingButtonIcon = "github",
  floatingButtonLabel = t("repo"),
  floatingButtonIconTransform = ""
} = Astro.props;
---

<html lang={lang}>
  <BaseHead title={title}>
    <slot name="head" />
  </BaseHead>
  <body class="mx-auto min-h-screen max-w-screen-sm p-3 font-sans sm:p-6 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
    <main>
      <slot />
    </main>
    <div class="fixed inset-0 z-[-1] pointer-events-none">
        <Image
            src={wallpaper}
            alt=""
            class="w-full h-full object-cover opacity-5"
            loading="eager"
            quality={80}
        />
    </div>
    <div class="fixed top-0 left-0 w-full h-full pointer-events-none z-50 mx-auto max-w-screen-sm inset-x-0">
        <ConfigModal />
        <a
        href={floatingButtonUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute pointer-events-auto top-8 right-8 flex items-center justify-center rounded-full border border-gray-200 bg-white p-3 shadow-lg transition-all hover:scale-110 hover:shadow-xl group dark:bg-gray-800 dark:border-gray-700"
        aria-label={floatingButtonLabel}
        >
        <Icon
            name={floatingButtonIcon}
            class={`w-6 h-6 text-gray-900 transition-colors group-hover:text-brand dark:text-gray-100 ${floatingButtonIconTransform}`}
        />
        </a>
    </div>
    <Footer />
  </body>
</html>
